# Local development only. Copy to .dev.vars; never commit .dev.vars.
ANTHROPIC_API_KEY=replace-with-your-api-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret

# Public configuration (safe to expose to the browser).
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-web-client-id

# Set only for local UI testing. Never enable in production.
MOCK_AI=false
